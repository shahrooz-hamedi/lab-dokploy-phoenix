# syntax=docker/dockerfile:1.7

ARG PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:2026.916.1
FROM ${PAPERCLIP_IMAGE}

USER root

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

# ---------------------------------------------------------------------------
# Base runtime dependencies
# ---------------------------------------------------------------------------

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        bash \
        jq \
        ripgrep \
        fd-find \
        unzip \
        zip \
        python3 \
        python3-pip \
        python3-venv \
        python3-ruamel.yaml \
        build-essential \
        gnupg \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Node.js 24
# ---------------------------------------------------------------------------

RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version \
    && npm --version

# ---------------------------------------------------------------------------
# Hermes Agent
# ---------------------------------------------------------------------------
#
# Paperclip adapter:
#
#   hermes_local
#
# Persistent Hermes state:
#
#   /paperclip/cli-home/.hermes
#
# ---------------------------------------------------------------------------

RUN mkdir -p /paperclip/cli-home/.hermes \
    && chown -R node:node /paperclip/cli-home \
    && rm -rf /home/node/.hermes \
    && ln -s /paperclip/cli-home/.hermes /home/node/.hermes \
    && chown -h node:node /home/node/.hermes \
    && su -s /bin/bash node -c \
       'export HOME=/home/node; \
        export PATH="$HOME/.local/bin:$PATH"; \
        curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash -s -- --non-interactive --skip-computer-use' \
    && test -x /home/node/.local/bin/hermes

ENV PATH=/home/node/.local/bin:${PATH}

# ---------------------------------------------------------------------------
# Claude Code
# ---------------------------------------------------------------------------

RUN npm install -g @anthropic-ai/claude-code \
    && claude --version

# ---------------------------------------------------------------------------
# OpenAI Codex
# ---------------------------------------------------------------------------

RUN npm install -g @openai/codex \
    && codex --version

# ---------------------------------------------------------------------------
# Gemini CLI
# ---------------------------------------------------------------------------

RUN npm install -g @google/gemini-cli \
    && gemini --version

# ---------------------------------------------------------------------------
# OpenCode
# ---------------------------------------------------------------------------

RUN npm install -g opencode-ai \
    && opencode --version

# ---------------------------------------------------------------------------
# Pi
# ---------------------------------------------------------------------------

RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent \
    && pi --version

# ---------------------------------------------------------------------------
# Kimi Code
# ---------------------------------------------------------------------------

RUN npm install -g @moonshot-ai/kimi-code \
    && kimi --version

# ---------------------------------------------------------------------------
# Grok Build
# ---------------------------------------------------------------------------

RUN npm install -g @xai-official/grok \
    && grok --version

# ---------------------------------------------------------------------------
# Cursor Agent
# ---------------------------------------------------------------------------
#
# Cursor installs its CLI as:
#
#   /root/.local/bin/agent
#
# The container ultimately runs as node, so do NOT expose it through a
# symlink into /root. Copy the executable into /usr/local/bin instead.
#
# ---------------------------------------------------------------------------

RUN bash -lc \
       'export HOME=/root; \
        export PATH="$HOME/.local/bin:$PATH"; \
        curl https://cursor.com/install -fsS | bash' \
    && test -e /root/.local/bin/agent \
    && cp -L /root/.local/bin/agent /usr/local/bin/agent \
    && chmod 755 /usr/local/bin/agent \
    && /usr/local/bin/agent --version

# ---------------------------------------------------------------------------
# Persistent runtime directories
# ---------------------------------------------------------------------------

RUN mkdir -p \
      /paperclip/cli-home/.config \
      /paperclip/cli-home/.cache \
      /paperclip/cli-home/.hermes \
      /paperclip/cli-home/.pi \
      /paperclip/cli-home/.kimi-code \
      /paperclip/cli-home/.grok \
      /paperclip/cli-home/.cursor \
      /paperclip/cli-home/.codex \
      /paperclip/cli-home/.claude \
      /paperclip/cli-home/.gemini \
      /paperclip/cli-home/.opencode \
      /paperclip/wiki \
    && chown node:node /paperclip/cli-home \
    && chown node:node /paperclip/wiki \
    && chown node:node /paperclip/cli-home/.config \
    && chown node:node /paperclip/cli-home/.cache \
    && chown node:node /paperclip/cli-home/.hermes \
    && chown node:node /paperclip/cli-home/.pi \
    && chown node:node /paperclip/cli-home/.kimi-code \
    && chown node:node /paperclip/cli-home/.grok \
    && chown node:node /paperclip/cli-home/.cursor \
    && chown node:node /paperclip/cli-home/.codex \
    && chown node:node /paperclip/cli-home/.claude \
    && chown node:node /paperclip/cli-home/.gemini \
    && chown node:node /paperclip/cli-home/.opencode

# ---------------------------------------------------------------------------
# Final runtime user
# ---------------------------------------------------------------------------

USER node