ARG PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:2026.916.1

FROM ${PAPERCLIP_IMAGE}

USER root

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/home/node \
    PAPERCLIP_HOME=/paperclip \
    HERMES_HOME=/home/node/.hermes \
    PATH=/home/node/.local/bin:/usr/local/bin:/usr/bin:/bin

# ============================================================================
# Runtime dependencies
# ============================================================================

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        bash \
        jq \
        ripgrep \
        fd-find \
        unzip \
        zip \
        python3 \
        python3-pip \
        python3-venv \
        build-essential \
        gnupg \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# Hermes Agent
# ============================================================================

RUN mkdir -p /home/node/.hermes \
    && chown -R node:node /home/node/.hermes \
    && su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export HERMES_HOME=/home/node/.hermes; \
        export PATH="$HOME/.local/bin:$PATH"; \
        curl -fsSL https://hermes-agent.nousresearch.com/install.sh | \
            bash -s -- \
                --non-interactive \
                --skip-browser \
                --skip-computer-use \
                --hermes-home /home/node/.hermes \
    ' \
    && test -x /home/node/.local/bin/hermes \
    && ln -sf /home/node/.local/bin/hermes /usr/local/bin/hermes \
    && su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export HERMES_HOME=/home/node/.hermes; \
        export PATH="$HOME/.local/bin:$PATH"; \
        hermes --version \
    '

# ============================================================================
# Additional local runtimes
# ============================================================================

RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent \
    && pi --version

RUN npm install -g @moonshot-ai/kimi-code \
    && kimi --version

RUN npm install -g @xai-official/grok \
    && grok --version

RUN su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export PATH="$HOME/.local/bin:$PATH"; \
        curl -fsSL https://cursor.com/install | bash \
    ' \
    && test -x /home/node/.local/bin/agent \
    && ln -sf /home/node/.local/bin/agent /usr/local/bin/agent \
    && su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export PATH="$HOME/.local/bin:$PATH"; \
        agent --version \
    '

# ============================================================================
# Persistent directories
# ============================================================================

RUN mkdir -p /paperclip /home/node/.hermes \
    && chown -R node:node /paperclip /home/node/.hermes

# ============================================================================
# Paperclip startup
#
# Creates the persistent instance config from environment variables on the
# first start. Existing config is preserved.
# ============================================================================

RUN cat > /usr/local/bin/paperclip-start <<'EOF'
#!/bin/bash
set -euo pipefail

INSTANCE_DIR="${PAPERCLIP_HOME}/instances/default"
CONFIG="${INSTANCE_DIR}/config.json"

mkdir -p "${INSTANCE_DIR}"

# ---------------------------------------------------------------------------
# Validate required deployment secrets.
# ---------------------------------------------------------------------------

if [ -z "${PAPERCLIP_SECRETS_MASTER_KEY:-}" ]; then
    echo "ERROR: PAPERCLIP_SECRETS_MASTER_KEY is required."
    exit 1
fi

if [ -z "${PAPERCLIP_AGENT_JWT_SECRET:-}" ]; then
    echo "ERROR: PAPERCLIP_AGENT_JWT_SECRET is required."
    exit 1
fi

if [ -z "${DATABASE_URL:-}" ]; then
    echo "ERROR: DATABASE_URL is required."
    exit 1
fi

# ---------------------------------------------------------------------------
# First-start Paperclip configuration.
#
# Never overwrite an existing config. This preserves the persistent instance.
# ---------------------------------------------------------------------------

if [ ! -f "${CONFIG}" ]; then
    echo "Paperclip config not found; creating deployment configuration..."

    cat > "${CONFIG}" <<CONFIG
{
  "\$meta": {
    "version": 1,
    "source": "phoenix-deployment"
  },
  "database": {
    "mode": "postgres",
    "connectionString": "${DATABASE_URL}",
    "embeddedPostgresDataDir": "/paperclip/instances/default/db",
    "embeddedPostgresPort": 54329,
    "backup": {
      "enabled": false,
      "intervalMinutes": 60,
      "retentionDays": 30,
      "dir": "/paperclip/instances/default/data/backups"
    }
  },
  "logging": {
    "mode": "file",
    "logDir": "/paperclip/instances/default/logs"
  },
  "server": {
    "deploymentMode": "${PAPERCLIP_DEPLOYMENT_MODE}",
    "exposure": "${PAPERCLIP_DEPLOYMENT_EXPOSURE}",
    "bind": "lan",
    "host": "0.0.0.0",
    "port": ${PORT},
    "allowedHostnames": [
      "${PAPERCLIP_ALLOWED_HOSTNAMES}"
    ],
    "serveUi": true
  },
  "telemetry": {
    "enabled": false
  },
  "updates": {
    "checkEnabled": false
  },
  "auth": {
    "baseUrlMode": "${PAPERCLIP_AUTH_BASE_URL_MODE}",
    "publicBaseUrl": "${PAPERCLIP_AUTH_PUBLIC_BASE_URL}",
    "disableSignUp": false
  },
  "storage": {
    "provider": "local_disk",
    "localDisk": {
      "baseDir": "/paperclip/instances/default/data/storage"
    },
    "s3": {
      "bucket": "paperclip",
      "region": "us-east-1",
      "prefix": "",
      "forcePathStyle": false
    }
  },
  "secrets": {
    "provider": "local_encrypted",
    "strictMode": true,
    "localEncrypted": {
      "keyFilePath": "/paperclip/instances/default/secrets/master.key"
    }
  }
}
CONFIG

    chmod 0600 "${CONFIG}"
    chown node:node "${CONFIG}"

    echo "Paperclip configuration created."
else
    echo "Using existing Paperclip configuration: ${CONFIG}"
fi

# ---------------------------------------------------------------------------
# Hermes configuration
# ---------------------------------------------------------------------------

HERMES_CONFIG="${HERMES_HOME}/config.yaml"

mkdir -p "${HERMES_HOME}"

cat > "${HERMES_CONFIG}" <<CONFIG
model:
  provider: custom:bifrost
  default: ${BIFROST_SELECTED_MODEL}
  context_length: 262144

providers:
  bifrost:
    name: Bifrost
    api: ${BIFROST_OPENAI_BASE_URL}
    key_env: BIFROST_API_KEY
    transport: chat_completions
    default_model: ${BIFROST_SELECTED_MODEL}
    context_length: 262144
    discover_models: true
CONFIG

chmod 0600 "${HERMES_CONFIG}"

# ---------------------------------------------------------------------------
# Start Paperclip.
# PAPERCLIP_UI_DEV_MIDDLEWARE=false is supplied by Compose/.env, so `run`
# does not force Vite development middleware.
# ---------------------------------------------------------------------------

exec /app/cli/node_modules/.bin/tsx \
  /app/cli/src/index.ts \
  run \
  --bind \
  lan
EOF

RUN chmod 0755 /usr/local/bin/paperclip-start

USER node