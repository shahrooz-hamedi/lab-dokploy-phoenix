ARG PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:2026.916.1
FROM ${PAPERCLIP_IMAGE}

USER root

ENV DEBIAN_FRONTEND=noninteractive 
PIP_DISABLE_PIP_VERSION_CHECK=1 
PYTHONDONTWRITEBYTECODE=1

—————————————————————————

Base runtime dependencies

—————————————————————————

RUN apt-get update 
&& apt-get install -y –no-install-recommends 
ca-certificates 
curl 
git 
bash 
jq 
ripgrep 
fd-find 
unzip 
zip 
python3 
python3-pip 
python3-venv 
python3-ruamel.yaml 
build-essential 
gnupg 
&& rm -rf /var/lib/apt/lists/*

—————————————————————————

Node.js 24

—————————————————————————

RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - 
&& apt-get update 
&& apt-get install -y –no-install-recommends nodejs 
&& rm -rf /var/lib/apt/lists/* 
&& node –version 
&& npm –version

—————————————————————————

Hermes Agent

Paperclip adapter:

hermes_local

Persistent Hermes state:

/paperclip/cli-home/.hermes

—————————————————————————

RUN mkdir -p /paperclip/cli-home/.hermes 
&& chown node:node /paperclip/cli-home 
&& chown node:node /paperclip/cli-home/.hermes 
&& rm -rf /home/node/.hermes 
&& ln -s /paperclip/cli-home/.hermes /home/node/.hermes 
&& chown -h node:node /home/node/.hermes 
&& su -s /bin/bash node -c 
‘export HOME=/home/node; 
export PATH=”$HOME/.local/bin:$PATH”; 
curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash -s – –non-interactive –skip-computer-use’ 
&& test -x /home/node/.local/bin/hermes 
&& ln -sf /home/node/.local/bin/hermes /usr/local/bin/hermes

ENV PATH=/home/node/.local/bin:${PATH}

—————————————————————————

Claude Code

—————————————————————————

RUN npm install -g @anthropic-ai/claude-code 
&& claude –version

—————————————————————————

OpenAI Codex

Codex uses a platform-specific optional dependency for its native binary.

npm may install the main package without installing that optional package.

Install the optional dependencies explicitly inside the installed package.

—————————————————————————

RUN npm install -g @openai/codex 
&& CODEX_DIR=”$(npm root -g)/@openai/codex” 
&& cd “$CODEX_DIR” 
&& npm install –include=optional 
&& test -x “$(command -v codex)” 
&& codex –version

—————————————————————————

