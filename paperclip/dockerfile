ARG PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:2026.916.1

FROM ${PAPERCLIP_IMAGE}

USER root

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/home/node \
    PAPERCLIP_HOME=/paperclip \
    HERMES_HOME=/home/node/.hermes \
    PATH=/home/node/.local/bin:/usr/local/bin:/usr/bin:/bin

# =============================================================================
# Runtime dependencies
# =============================================================================

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        bash \
        jq \
        ripgrep \
        fd-find \
        unzip \
        zip \
        python3 \
        python3-pip \
        python3-venv \
        build-essential \
        gnupg \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# Hermes Agent
#
# Paperclip ships the hermes_local adapter natively.
# No Hermes adapter/plugin installation is required.
#
# Hermes is installed into:
#   /home/node/.hermes
#
# The runtime compose file persists this directory with:
#   paperclip-hermes:/home/node/.hermes
# =============================================================================

RUN mkdir -p /home/node/.hermes \
    && chown -R node:node /home/node/.hermes \
    && su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export HERMES_HOME=/home/node/.hermes; \
        export PATH="$HOME/.local/bin:$PATH"; \
        curl -fsSL https://hermes-agent.nousresearch.com/install.sh | \
            bash -s -- \
                --non-interactive \
                --skip-browser \
                --hermes-home /home/node/.hermes \
    ' \
    && test -x /home/node/.local/bin/hermes \
    && ln -sf /home/node/.local/bin/hermes /usr/local/bin/hermes \
    && su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export HERMES_HOME=/home/node/.hermes; \
        export PATH="$HOME/.local/bin:$PATH"; \
        hermes --version \
    '

# =============================================================================
# Claude Code
# =============================================================================

RUN npm install -g @anthropic-ai/claude-code \
    && claude --version

# =============================================================================
# OpenAI Codex
# =============================================================================

RUN npm install -g @openai/codex \
    && CODEX_DIR="$(npm root -g)/@openai/codex" \
    && cd "$CODEX_DIR" \
    && npm install --include=optional \
    && codex --version

# =============================================================================
# Gemini CLI
# =============================================================================

RUN npm install -g @google/gemini-cli \
    && gemini --version

# =============================================================================
# OpenCode
# =============================================================================

RUN npm install -g opencode-ai \
    && opencode --version

# =============================================================================
# Pi
# =============================================================================

RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent \
    && pi --version

# =============================================================================
# Kimi Code
# =============================================================================

RUN npm install -g @moonshot-ai/kimi-code \
    && kimi --version

# =============================================================================
# Grok Build
# =============================================================================

RUN npm install -g @xai-official/grok \
    && grok --version

# =============================================================================
# Cursor Agent
# =============================================================================

RUN su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export PATH="$HOME/.local/bin:$PATH"; \
        curl -fsSL https://cursor.com/install | bash \
    ' \
    && test -x /home/node/.local/bin/agent \
    && ln -sf /home/node/.local/bin/agent /usr/local/bin/agent \
    && su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export PATH="$HOME/.local/bin:$PATH"; \
        agent --version \
    '

# =============================================================================
# Persistent Paperclip directories
#
# These live under /paperclip and are persisted by paperclip-data.
#
# Hermes is intentionally NOT stored here.
# Hermes has its own Docker volume mounted at /home/node/.hermes.
# =============================================================================

RUN mkdir -p \
        /paperclip/cli-home/.config \
        /paperclip/cli-home/.cache \
        /paperclip/cli-home/.pi \
        /paperclip/cli-home/.kimi-code \
        /paperclip/cli-home/.grok \
        /paperclip/cli-home/.cursor \
        /paperclip/cli-home/.codex \
        /paperclip/cli-home/.claude \
        /paperclip/cli-home/.gemini \
        /paperclip/cli-home/.opencode \
        /paperclip/wiki \
    && chown -R node:node /paperclip

# =============================================================================
# Final runtime user
# =============================================================================

USER node