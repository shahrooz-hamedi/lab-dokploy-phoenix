# syntax=docker/dockerfile:1.7

ARG PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:2026.916.1
FROM ${PAPERCLIP_IMAGE}

USER root

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

# ---------------------------------------------------------------------------
# Base runtime dependencies
# ---------------------------------------------------------------------------
#
# Node.js 24 is intentional:
# - Paperclip's current Codex ACP prerequisite is Node >=24.11
# - current Kimi Code requires Node >=24.15
#
# Also provide the common Unix tooling expected by coding agents.
#

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        bash \
        jq \
        ripgrep \
        fd-find \
        unzip \
        zip \
        python3 \
        python3-pip \
        python3-venv \
        build-essential \
        gnupg \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Node.js 24
# ---------------------------------------------------------------------------

RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version \
    && npm --version

# ---------------------------------------------------------------------------
# Hermes Agent
# ---------------------------------------------------------------------------
#
# Paperclip's hermes_local adapter expects the normal:
#
#   $HOME/.hermes
#
# Keep HOME as /home/node, but persist ~/.hermes through the existing
# /paperclip Docker volume.
#
# The symlink is created before running the Hermes installer so Hermes
# state/configuration is placed in persistent storage.
#
# Hermes executable:
#
#   /home/node/.local/bin/hermes
#

RUN mkdir -p /paperclip/cli-home/.hermes \
    && chown -R node:node /paperclip/cli-home \
    && rm -rf /home/node/.hermes \
    && ln -s /paperclip/cli-home/.hermes /home/node/.hermes \
    && chown -h node:node /home/node/.hermes \
    && su -s /bin/bash node -c \
       'HOME=/home/node \
        curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash -s -- --non-interactive' \
    && test -x /home/node/.local/bin/hermes \
    && /home/node/.local/bin/hermes --version

ENV PATH=/home/node/.local/bin:${PATH}

# ---------------------------------------------------------------------------
# Claude Code
# ---------------------------------------------------------------------------
#
# Paperclip adapter: claude_local
#

RUN npm install -g @anthropic-ai/claude-code \
    && claude --version

# ---------------------------------------------------------------------------
# OpenAI Codex
# ---------------------------------------------------------------------------
#
# Paperclip adapter: codex_local
#

RUN npm install -g @openai/codex \
    && codex --version

# ---------------------------------------------------------------------------
# Gemini CLI
# ---------------------------------------------------------------------------
#
# Paperclip adapter: gemini_local
#

RUN npm install -g @google/gemini-cli \
    && gemini --version

# ---------------------------------------------------------------------------
# OpenCode
# ---------------------------------------------------------------------------
#
# Paperclip adapter: opencode_local
#

RUN npm install -g opencode-ai \
    && opencode --version

# ---------------------------------------------------------------------------
# Pi
# ---------------------------------------------------------------------------
#
# Paperclip adapter: pi_local
#

RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent \
    && pi --version

# ---------------------------------------------------------------------------
# Kimi Code
# ---------------------------------------------------------------------------
#
# Paperclip adapter: kimi_local
#

RUN npm install -g @moonshot-ai/kimi-code \
    && kimi --version

# ---------------------------------------------------------------------------
# Grok Build
# ---------------------------------------------------------------------------
#
# Paperclip adapter: grok_local
#

RUN npm install -g @xai-official/grok \
    && grok --version

# ---------------------------------------------------------------------------
# Cursor Agent
# ---------------------------------------------------------------------------
#
# Paperclip adapter: cursor
#
# Cursor's official installer provides:
#
#   cursor-agent
#
# Paperclip's cursor adapter defaults to:
#
#   agent
#
# Therefore provide the expected `agent` executable as a symlink.
#

RUN curl https://cursor.com/install -fsS | bash \
    && if [ -x /root/.local/bin/cursor-agent ]; then \
         install -m 0755 /root/.local/bin/cursor-agent /usr/local/bin/cursor-agent; \
       elif [ -x /root/.cursor/bin/cursor-agent ]; then \
         install -m 0755 /root/.cursor/bin/cursor-agent /usr/local/bin/cursor-agent; \
       else \
         echo "Cursor Agent CLI was not installed where expected" >&2; \
         exit 1; \
       fi \
    && ln -sf /usr/local/bin/cursor-agent /usr/local/bin/agent \
    && /usr/local/bin/cursor-agent --version

# ---------------------------------------------------------------------------
# Persistent runtime directories
# ---------------------------------------------------------------------------
#
# /paperclip is backed by the paperclip-data Docker volume.
#
# Paperclip itself uses:
#
#   PAPERCLIP_HOME=/paperclip
#
# CLI-specific homes are kept under /paperclip/cli-home so they survive
# container recreation without changing Paperclip's application home.
#

RUN mkdir -p \
      /paperclip/cli-home \
      /paperclip/cli-home/.config \
      /paperclip/cli-home/.cache \
      /paperclip/cli-home/.hermes \
      /paperclip/cli-home/.pi \
      /paperclip/cli-home/.kimi-code \
      /paperclip/cli-home/.grok \
      /paperclip/cli-home/.cursor \
      /paperclip/cli-home/.codex \
      /paperclip/cli-home/.claude \
      /paperclip/cli-home/.gemini \
      /paperclip/cli-home/.opencode \
      /paperclip/wiki \
    && chown -R node:node /paperclip/cli-home /paperclip/wiki

# ---------------------------------------------------------------------------
# Final runtime user
# ---------------------------------------------------------------------------

USER node