ARGPAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:2026.916.1
FROM${PAPERCLIP_IMAGE}

USERroot

ENVDEBIAN_FRONTEND=noninteractive\
PIP_DISABLE_PIP_VERSION_CHECK=1\
PYTHONDONTWRITEBYTECODE=1\
HERMES_HOME=/home/node/.hermes

RUNapt-getupdate\
&&apt-getinstall-y--no-install-recommends\
ca-certificates\
curl\
git\
bash\
jq\
ripgrep\
fd-find\
unzip\
zip\
python3\
python3-pip\
python3-venv\
build-essential\
gnupg\
&&rm-rf/var/lib/apt/lists/*

RUNmkdir-p/home/node/.hermes\
&&chown-Rnode:node/home/node/.hermes

RUNsu-s/bin/bashnode-c'\
exportHOME=/home/node;\
exportHERMES_HOME=/home/node/.hermes;\
exportPATH="$HOME/.local/bin:$PATH";\
curl-fsSLhttps://hermes-agent.nousresearch.com/install.sh|\
bash-s--\
--non-interactive\
--skip-browser\
--skip-computer-use\
--hermes-home/home/node/.hermes\
'\
&&test-x/home/node/.local/bin/hermes\
&&ln-sf/home/node/.local/bin/hermes/usr/local/bin/hermes\
&&su-s/bin/bashnode-c'\
exportHOME=/home/node;\
exportHERMES_HOME=/home/node/.hermes;\
exportPATH="$HOME/.local/bin:$PATH";\
hermes--version\
'

RUNnpminstall-g--ignore-scripts@earendil-works/pi-coding-agent\
&&pi--version

RUNnpminstall-g@xai-official/grok\
&&grok--version

RUNsu-s/bin/bashnode-c'\
exportHOME=/home/node;\
exportPATH="$HOME/.local/bin:$PATH";\
curl-fsSLhttps://cursor.com/install|bash\
'\
&&test-x/home/node/.local/bin/agent\
&&ln-sf/home/node/.local/bin/agent/usr/local/bin/agent\
&&su-s/bin/bashnode-c'\
exportHOME=/home/node;\
exportPATH="$HOME/.local/bin:$PATH";\
agent--version\
'

RUNmkdir-p/home/node/.hermes\
&&chown-Rnode:node/home/node/.hermes

USERnode