# syntax=docker/dockerfile:1.7

ARG PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:2026.916.1
FROM ${PAPERCLIP_IMAGE}

USER root

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HERMES_HOME=/opt/hermes

# ---------------------------------------------------------------------------
# Base runtime dependencies
# ---------------------------------------------------------------------------
#
# Node.js 24 is intentional:
# - Paperclip's current Codex ACP prerequisite is Node >=24.11
# - current Kimi Code requires Node >=24.15
#
# Also provide the common Unix tooling expected by coding agents.
#

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        bash \
        jq \
        ripgrep \
        fd-find \
        unzip \
        zip \
        python3 \
        python3-pip \
        python3-venv \
        build-essential \
        gnupg \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Node.js 24
# ---------------------------------------------------------------------------

RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version \
    && npm --version

# ---------------------------------------------------------------------------
# Hermes Agent
# ---------------------------------------------------------------------------
#
# Paperclip's hermes_local adapter launches the `hermes` executable.
# Install Hermes into a dedicated persistent-friendly location.
#

RUN mkdir -p /opt/hermes \
    && chown -R node:node /opt/hermes \
    && su -s /bin/bash node -c \
       'HOME=/opt/hermes HERMES_HOME=/opt/hermes \
        curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash' \
    && test -x /opt/hermes/.local/bin/hermes \
    && /opt/hermes/.local/bin/hermes --version

ENV PATH=/opt/hermes/.local/bin:/opt/hermes/bin:${PATH}

# ---------------------------------------------------------------------------
# Claude Code
# ---------------------------------------------------------------------------
#
# Paperclip adapter: claude_local
#

RUN npm install -g @anthropic-ai/claude-code \
    && claude --version

# ---------------------------------------------------------------------------
# OpenAI Codex
# ---------------------------------------------------------------------------
#
# Paperclip adapter: codex_local
#

RUN npm install -g @openai/codex \
    && codex --version

# ---------------------------------------------------------------------------
# Gemini CLI
# ---------------------------------------------------------------------------
#
# Paperclip adapter: gemini_local
#

RUN npm install -g @google/gemini-cli \
    && gemini --version

# ---------------------------------------------------------------------------
# OpenCode
# ---------------------------------------------------------------------------
#
# Paperclip adapter: opencode_local
#
# Paperclip's current adapter runtime expects the `opencode-ai` package.
#

RUN npm install -g opencode-ai \
    && opencode --version

# ---------------------------------------------------------------------------
# Pi
# ---------------------------------------------------------------------------
#
# Paperclip adapter: pi_local
#

RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent \
    && pi --version

# ---------------------------------------------------------------------------
# Kimi Code
# ---------------------------------------------------------------------------
#
# Paperclip adapter: kimi_local
#

RUN npm install -g @moonshot-ai/kimi-code \
    && kimi --version

# ---------------------------------------------------------------------------
# Grok Build
# ---------------------------------------------------------------------------
#
# Paperclip adapter: grok_local
#

RUN npm install -g @xai-official/grok \
    && grok --version

# ---------------------------------------------------------------------------
# Cursor Agent
# ---------------------------------------------------------------------------
#
# Paperclip adapter: cursor
#
# The Paperclip adapter defaults to the `agent` executable.
# Cursor's official installer provides `cursor-agent`.
#

RUN curl https://cursor.com/install -fsS | bash \
    && if [ -x /root/.local/bin/cursor-agent ]; then \
         install -m 0755 /root/.local/bin/cursor-agent /usr/local/bin/cursor-agent; \
       elif [ -x /root/.cursor/bin/cursor-agent ]; then \
         install -m 0755 /root/.cursor/bin/cursor-agent /usr/local/bin/cursor-agent; \
       else \
         echo "Cursor Agent CLI was not installed where expected" >&2; \
         exit 1; \
       fi \
    && ln -sf /usr/local/bin/cursor-agent /usr/local/bin/agent \
    && /usr/local/bin/cursor-agent --version

# ---------------------------------------------------------------------------
# Persistent runtime directories
# ---------------------------------------------------------------------------
#
# Paperclip owns /paperclip and this directory is backed by paperclip-data.
# Keep runtime-specific state here where the adapter supports configurable
# homes, while leaving Paperclip's own application state untouched.
#

RUN mkdir -p \
      /paperclip/cli-home \
      /paperclip/cli-home/.config \
      /paperclip/cli-home/.cache \
      /paperclip/cli-home/.pi \
      /paperclip/cli-home/.kimi-code \
      /paperclip/cli-home/.grok \
      /paperclip/cli-home/.cursor \
      /paperclip/cli-home/.codex \
      /paperclip/cli-home/.claude \
      /paperclip/cli-home/.gemini \
      /paperclip/cli-home/.opencode \
      /paperclip/wiki \
    && chown -R node:node /paperclip/cli-home /paperclip/wiki

# ---------------------------------------------------------------------------
# Final runtime user
# ---------------------------------------------------------------------------

USER node