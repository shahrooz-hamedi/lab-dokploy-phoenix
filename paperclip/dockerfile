FROM ghcr.io/paperclipai/paperclip:2026.916.1

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3-pip \
        python3.13-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --break-system-packages hermes-agent \
    && hermes --version

USER node