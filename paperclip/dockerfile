ARG PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:2026.916.1

FROM ${PAPERCLIP_IMAGE}

USER root

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/node \
    PAPERCLIP_HOME=/paperclip \
    HERMES_HOME=/home/node/.hermes \
    PATH=/home/node/.local/bin:/usr/local/bin:/usr/bin:/bin

# ============================================================================
# Runtime dependencies
# ============================================================================
#
# Official Paperclip image already provides:
#   Claude Code
#   Codex
#   OpenCode
#   Gemini CLI
#   Kimi Code
#
# Additional runtimes intentionally installed here:
#   Hermes
#   Pi
#   Grok
#   Cursor Agent
#
# Do NOT replace the official Paperclip ENTRYPOINT/CMD.
# ============================================================================

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        build-essential \
        unzip \
        zip \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# Hermes Agent
# ============================================================================
#
# Install as node so the installation is already owned by the runtime user.
# Do not recursively chown the Hermes tree.
#
# Hermes configuration is intentionally NOT baked into the image.
# The runtime mounts /home/node/.hermes as a persistent volume.
# ============================================================================

RUN mkdir -p /home/node/.hermes \
    && chown node:node /home/node/.hermes \
    && su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export HERMES_HOME=/home/node/.hermes; \
        export PATH="$HOME/.local/bin:$PATH"; \
        curl -fsSL https://hermes-agent.nousresearch.com/install.sh | \
          bash -s -- \
            --non-interactive \
            --skip-browser \
            --skip-computer-use \
            --hermes-home /home/node/.hermes \
    ' \
    && test -x /home/node/.local/bin/hermes \
    && ln -sf /home/node/.local/bin/hermes /usr/local/bin/hermes \
    && su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export HERMES_HOME=/home/node/.hermes; \
        export PATH="$HOME/.local/bin:$PATH"; \
        hermes --version \
    '

# ============================================================================
# Pi coding agent
# ============================================================================

RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent \
    && pi --version

# ============================================================================
# Grok CLI
# ============================================================================

RUN npm install -g @xai-official/grok \
    && grok --version

# ============================================================================
# Cursor Agent
# ============================================================================

RUN su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export PATH="$HOME/.local/bin:$PATH"; \
        curl -fsSL https://cursor.com/install | bash \
    ' \
    && test -x /home/node/.local/bin/agent \
    && ln -sf /home/node/.local/bin/agent /usr/local/bin/agent \
    && su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export PATH="$HOME/.local/bin:$PATH"; \
        agent --version \
    '

# ============================================================================
# Return to official Paperclip runtime user
# ============================================================================

USER node