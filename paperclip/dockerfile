# syntax=docker/dockerfile:1.7

ARG PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:2026.916.1
FROM ${PAPERCLIP_IMAGE}

USER root

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

# ---------------------------------------------------------------------------
# Base runtime dependencies
# ---------------------------------------------------------------------------

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        bash \
        jq \
        ripgrep \
        fd-find \
        unzip \
        zip \
        python3 \
        python3-pip \
        python3-venv \
        build-essential \
        gnupg \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Node.js 24
# ---------------------------------------------------------------------------

RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version \
    && npm --version

# ---------------------------------------------------------------------------
# Hermes Agent
# ---------------------------------------------------------------------------
#
# Paperclip adapter:
#
#   hermes_local
#
# Hermes state is persisted under:
#
#   /paperclip/cli-home/.hermes
#
# The installer must receive HOME=/home/node.
#
# Computer Use is intentionally skipped because Paperclip's headless
# hermes_local adapter does not require it.
#

RUN mkdir -p /paperclip/cli-home/.hermes \
    && chown -R node:node /paperclip/cli-home \
    && rm -rf /home/node/.hermes \
    && ln -s /paperclip/cli-home/.hermes /home/node/.hermes \
    && chown -h node:node /home/node/.hermes \
    && su -s /bin/bash node -c \
       'export HOME=/home/node; \
        export PATH="$HOME/.local/bin:$PATH"; \
        curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash -s -- --non-interactive --skip-computer-use' \
    && test -x /home/node/.local/bin/hermes

ENV PATH=/home/node/.local/bin:${PATH}

# ---------------------------------------------------------------------------
# Claude Code
# ---------------------------------------------------------------------------
#
# Paperclip adapter:
#
#   claude_local
#

RUN npm install -g @anthropic-ai/claude-code \
    && claude --version

# ---------------------------------------------------------------------------
# OpenAI Codex
# ---------------------------------------------------------------------------
#
# Paperclip adapter:
#
#   codex_local
#

RUN npm install -g @openai/codex \
    && codex --version

# ---------------------------------------------------------------------------
# Gemini CLI
# ---------------------------------------------------------------------------
#
# Paperclip adapter:
#
#   gemini_local
#

RUN npm install -g @google/gemini-cli \
    && gemini --version

# ---------------------------------------------------------------------------
# OpenCode
# ---------------------------------------------------------------------------
#
# Paperclip adapter:
#
#   opencode_local
#

RUN npm install -g opencode-ai \
    && opencode --version

# ---------------------------------------------------------------------------
# Pi
# ---------------------------------------------------------------------------
#
# Paperclip adapter:
#
#   pi_local
#

RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent \
    && pi --version

# ---------------------------------------------------------------------------
# Kimi Code
# ---------------------------------------------------------------------------
#
# Paperclip adapter:
#
#   kimi_local
#

RUN npm install -g @moonshot-ai/kimi-code \
    && kimi --version

# ---------------------------------------------------------------------------
# Grok Build
# ---------------------------------------------------------------------------
#
# Paperclip adapter:
#
#   grok_local
#

RUN npm install -g @xai-official/grok \
    && grok --version

# ---------------------------------------------------------------------------
# Cursor Agent
# ---------------------------------------------------------------------------
#
# Paperclip adapter:
#
#   cursor
#
# The official Cursor installer installs the CLI as:
#
#   agent
#
# It may place it under ~/.local/bin or another user-local location.
#
# Install as root, locate the resulting executable, then place a stable
# system-wide copy at:
#
#   /usr/local/bin/agent
#
# This is also the default executable expected by Paperclip's cursor adapter.
#

RUN curl https://cursor.com/install -fsS | bash \
    && CURSOR_AGENT="$(find /root -type f -name agent -perm /111 2>/dev/null | head -n 1)" \
    && if [ -z "$CURSOR_AGENT" ]; then \
         echo "Cursor Agent CLI executable 'agent' was not found" >&2; \
         echo "Installed files under /root:" >&2; \
         find /root -maxdepth 4 -type f 2>/dev/null | grep -E '/(agent|cursor)' | head -100 >&2 || true; \
         exit 1; \
       fi \
    && install -m 0755 "$CURSOR_AGENT" /usr/local/bin/agent \
    && /usr/local/bin/agent --version

# ---------------------------------------------------------------------------
# Persistent runtime directories
# ---------------------------------------------------------------------------
#
# /paperclip is backed by the paperclip-data Docker volume.
#
# Paperclip itself uses:
#
#   PAPERCLIP_HOME=/paperclip
#
# CLI-specific homes are kept under /paperclip/cli-home.
#

RUN mkdir -p \
      /paperclip/cli-home \
      /paperclip/cli-home/.config \
      /paperclip/cli-home/.cache \
      /paperclip/cli-home/.hermes \
      /paperclip/cli-home/.pi \
      /paperclip/cli-home/.kimi-code \
      /paperclip/cli-home/.grok \
      /paperclip/cli-home/.cursor \
      /paperclip/cli-home/.codex \
      /paperclip/cli-home/.claude \
      /paperclip/cli-home/.gemini \
      /paperclip/cli-home/.opencode \
      /paperclip/wiki \
    && chown -R node:node /paperclip/cli-home /paperclip/wiki

# ---------------------------------------------------------------------------
# Final runtime user
# ---------------------------------------------------------------------------

USER node