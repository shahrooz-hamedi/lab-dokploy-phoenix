RUN npm install -g @xai-official/grok 
&& grok –version

—————————————————————————

Cursor Agent

Paperclip adapter:

cursor

Cursor is installed as the node user.

The installation remains under /home/node/.local/.

The launcher is exposed through /usr/local/bin without copying it,

preserving Cursor’s installation-relative paths.

—————————————————————————

RUN su -s /bin/bash node -c 
‘export HOME=/home/node; 
export PATH=”$HOME/.local/bin:$PATH”; 
curl https://cursor.com/install -fsS | bash’ 
&& test -x /home/node/.local/bin/agent 
&& ln -sf /home/node/.local/bin/agent /usr/local/bin/agent 
&& su -s /bin/bash node -c 
‘export HOME=/home/node; 
export PATH=”$HOME/.local/bin:$PATH”; 
agent –version’

