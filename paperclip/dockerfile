ARG PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:2026.916.1

FROM ${PAPERCLIP_IMAGE}

USER root

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/node \
    PAPERCLIP_HOME=/paperclip \
    HERMES_HOME=/home/node/.hermes \
    PATH=/home/node/.local/bin:/usr/local/bin:/usr/bin:/bin

# ============================================================================
# Runtime dependencies for the additional agent CLIs we intentionally add.
#
# The official Paperclip image already provides:
#   Claude Code
#   Codex
#   OpenCode
#   Gemini CLI
#   Kimi Code
#
# We add:
#   Hermes
#   Pi
#   Grok
#   Cursor Agent
# ============================================================================

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        build-essential \
        unzip \
        zip \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# Hermes Agent
# ============================================================================
#
# Install Hermes as the node user so its entire installation is already
# owned correctly. This avoids the very expensive recursive chown that
# previously took ~12 minutes.
# ============================================================================

RUN mkdir -p /home/node/.hermes \
    && chown node:node /home/node/.hermes \
    && su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export HERMES_HOME=/home/node/.hermes; \
        export PATH="$HOME/.local/bin:$PATH"; \
        curl -fsSL https://hermes-agent.nousresearch.com/install.sh | \
          bash -s -- \
            --non-interactive \
            --skip-browser \
            --skip-computer-use \
            --hermes-home /home/node/.hermes \
    ' \
    && test -x /home/node/.local/bin/hermes \
    && ln -sf /home/node/.local/bin/hermes /usr/local/bin/hermes \
    && su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export HERMES_HOME=/home/node/.hermes; \
        export PATH="$HOME/.local/bin:$PATH"; \
        hermes --version \
    '

# ============================================================================
# Pi
# ============================================================================

RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent \
    && pi --version

# ============================================================================
# Grok
# ============================================================================

RUN npm install -g @xai-official/grok \
    && grok --version

# ============================================================================
# Cursor Agent
# ============================================================================

RUN su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export PATH="$HOME/.local/bin:$PATH"; \
        curl -fsSL https://cursor.com/install | bash \
    ' \
    && test -x /home/node/.local/bin/agent \
    && ln -sf /home/node/.local/bin/agent /usr/local/bin/agent \
    && su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export PATH="$HOME/.local/bin:$PATH"; \
        agent --version \
    '

# ============================================================================
# Hermes → Bifrost
# ============================================================================
#
# This is Hermes configuration, NOT Paperclip configuration.
#
# Paperclip's official config remains owned by Paperclip itself.
# Hermes reads this persistent config when the hermes_local adapter runs.
# ============================================================================

RUN su -s /bin/bash node -c '\
        cat > /home/node/.hermes/config.yaml <<'"'"'EOF'"'"'
model:
  provider: custom:bifrost
  default: hermes-main-free
  context_length: 262144

providers:
  bifrost:
    name: Bifrost
    api: https://bifrost.phoenix-rtp.com/v1
    key_env: BIFROST_API_KEY
    transport: chat_completions
    default_model: hermes-main-free
    context_length: 262144
    discover_models: true
EOF
    ' \
    && chmod 0700 /home/node/.hermes \
    && chown node:node /home/node/.hermes/config.yaml \
    && chmod 0600 /home/node/.hermes/config.yaml

# ============================================================================
# Return to the official Paperclip runtime user.
# IMPORTANT: do not replace the official Paperclip ENTRYPOINT/CMD.
# ============================================================================

USER node