ARG PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:2026.916.1

FROM ${PAPERCLIP_IMAGE}

USER root

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/home/node \
    PAPERCLIP_HOME=/paperclip \
    HERMES_HOME=/home/node/.hermes \
    PATH=/home/node/.local/bin:/usr/local/bin:/usr/bin:/bin

# ============================================================================
# Runtime dependencies
# ============================================================================

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        bash \
        jq \
        ripgrep \
        fd-find \
        unzip \
        zip \
        python3 \
        python3-pip \
        python3-venv \
        build-essential \
        gnupg \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# Hermes Agent
#
# Paperclip has a native hermes_local adapter.
# Hermes is installed into its own persistent volume.
#
# Computer Use is deliberately disabled because this is a headless
# Paperclip server container.
# ============================================================================

RUN mkdir -p /home/node/.hermes \
    && chown -R node:node /home/node/.hermes \
    && su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export HERMES_HOME=/home/node/.hermes; \
        export PATH="$HOME/.local/bin:$PATH"; \
        curl -fsSL https://hermes-agent.nousresearch.com/install.sh | \
            bash -s -- \
                --non-interactive \
                --skip-browser \
                --skip-computer-use \
                --hermes-home /home/node/.hermes \
    ' \
    && test -x /home/node/.local/bin/hermes \
    && ln -sf /home/node/.local/bin/hermes /usr/local/bin/hermes \
    && su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export HERMES_HOME=/home/node/.hermes; \
        export PATH="$HOME/.local/bin:$PATH"; \
        hermes --version \
    '

# ============================================================================
# Additional local runtimes
#
# Claude, Codex, Gemini and OpenCode are supplied by the official
# Paperclip image and are intentionally NOT reinstalled here.
# ============================================================================

RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent \
    && pi --version

RUN npm install -g @moonshot-ai/kimi-code \
    && kimi --version

RUN npm install -g @xai-official/grok \
    && grok --version

RUN su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export PATH="$HOME/.local/bin:$PATH"; \
        curl -fsSL https://cursor.com/install | bash \
    ' \
    && test -x /home/node/.local/bin/agent \
    && ln -sf /home/node/.local/bin/agent /usr/local/bin/agent \
    && su -s /bin/bash node -c '\
        export HOME=/home/node; \
        export PATH="$HOME/.local/bin:$PATH"; \
        agent --version \
    '

# ============================================================================
# Persistent Paperclip state
# ============================================================================

RUN mkdir -p /paperclip \
    && chown -R node:node /paperclip

# ============================================================================
# Paperclip startup wrapper
# ============================================================================

RUN cat > /usr/local/bin/paperclip-start <<'EOF'
#!/bin/bash
set -euo pipefail

HERMES_CONFIG="${HERMES_HOME}/config.yaml"

mkdir -p "${HERMES_HOME}"

cat > "${HERMES_CONFIG}" <<CONFIG
model:
  provider: custom:bifrost
  default: ${BIFROST_SELECTED_MODEL}
  context_length: 262144

providers:
  bifrost:
    name: Bifrost
    api: ${BIFROST_OPENAI_BASE_URL}
    key_env: BIFROST_API_KEY
    transport: chat_completions
    default_model: ${BIFROST_SELECTED_MODEL}
    context_length: 262144
    discover_models: true
CONFIG

exec /app/cli/node_modules/.bin/tsx \
  /app/cli/src/index.ts \
  run \
  --bind \
  lan
EOF

RUN chmod 0755 /usr/local/bin/paperclip-start

USER node