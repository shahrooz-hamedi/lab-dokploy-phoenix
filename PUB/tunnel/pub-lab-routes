#!/bin/sh
set -eu

IFACE="ct-pub-lab"
REMOTE_PEER="10.100.10.10"

echo "[PUB-SITE-ROUTES] Waiting for ${IFACE}..."

i=0
until ip link show dev "$IFACE" >/dev/null 2>&1; do
    i=$((i + 1))
    if [ "$i" -ge 30 ]; then
        echo "[PUB-SITE-ROUTES] ERROR: ${IFACE} is unavailable." >&2
        exit 1
    fi
    sleep 1
done

echo "[PUB-SITE-ROUTES] Installing LAB network routes via ${REMOTE_PEER}..."

ip route replace 192.168.10.0/24 via "$REMOTE_PEER" dev "$IFACE"
ip route replace 192.168.11.0/24 via "$REMOTE_PEER" dev "$IFACE"

echo "[PUB-SITE-ROUTES] Installed routes:"
ip route show 192.168.10.0/24
ip route show 192.168.11.0/24

echo "[PUB-SITE-ROUTES] Configuration complete."