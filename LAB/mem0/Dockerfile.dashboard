FROM node:20-alpine AS base

RUN apk add --no-cache libc6-compat git

WORKDIR /app

FROM base AS source

RUN git clone --depth 1 https://github.com/mem0ai/mem0.git /tmp/mem0 \
    && cp -a /tmp/mem0/server/dashboard/. /app/ \
    && rm -rf /tmp/mem0

FROM base AS deps

COPY --from=source /app/ ./

RUN corepack enable \
    && corepack prepare pnpm@10.34.2 --activate \
    && pnpm install --no-frozen-lockfile

FROM base AS builder

RUN corepack enable \
    && corepack prepare pnpm@10.34.2 --activate

COPY --from=deps /app/ ./

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_URL=NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_INSTANCE_NAME=NEXT_PUBLIC_INSTANCE_NAME

RUN pnpm build

FROM base AS runner

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/entrypoint.sh /home/nextjs/entrypoint.sh

RUN chmod +x /home/nextjs/entrypoint.sh

USER nextjs

EXPOSE 3000

ENTRYPOINT ["/home/nextjs/entrypoint.sh"]

CMD ["node", "server.js"]