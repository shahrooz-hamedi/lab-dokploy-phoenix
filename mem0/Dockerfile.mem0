FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/mem0ai/mem0.git /tmp/mem0 \
    && cp -a /tmp/mem0/server/. /app/ \
    && rm -rf /tmp/mem0

RUN python - <<'PY'
from pathlib import Path

# Fix PGVector dimensions in the Mem0 server configuration.
p = Path("/app/main.py")
s = p.read_text()

old = '''            "collection_name": POSTGRES_COLLECTION_NAME,
        },'''

new = '''            "collection_name": POSTGRES_COLLECTION_NAME,
            "embedding_model_dims": int(os.environ.get("MEM0_EMBEDDING_MODEL_DIMS", "1536")),
        },'''

if old not in s:
    raise SystemExit("Expected pgvector configuration block not found in main.py")

p.write_text(s.replace(old, new, 1))

# Fix psycopg3 pool initialization for Docker.
p = Path("/usr/local/lib/python3.12/site-packages/mem0/vector_stores/pgvector.py")

s = p.read_text()

old = '''                # open=False avoids blocking when DB DNS is not yet resolvable (e.g. Docker startup)
                self.connection_pool = ConnectionPool(
                    conninfo=connection_string,
                    min_size=minconn,
                    max_size=maxconn,
                    open=False,
                )
                self.connection_pool.open(wait=False)'''

new = '''                self.connection_pool = ConnectionPool(
                    conninfo=connection_string,
                    min_size=minconn,
                    max_size=maxconn,
                    open=False,
                )
                self.connection_pool.open(wait=True)'''

if old not in s:
    raise SystemExit("Expected psycopg3 ConnectionPool block not found")

p.write_text(s.replace(old, new, 1))
PY

RUN pip install --no-cache-dir -r requirements.txt

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

EXPOSE 8000

CMD ["sh", "-c", "alembic upgrade head && uvicorn main:app --host 0.0.0.0 --port 8000"]