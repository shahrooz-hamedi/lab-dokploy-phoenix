cd ~/lab-dokploy-phoenix/mem0
cat > Dockerfile.mem0 <<'EOF'
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# Use current official Mem0 server source.
RUN git clone --depth 1 https://github.com/mem0ai/mem0.git /tmp/mem0 \
    && cp -a /tmp/mem0/server/. /app/ \
    && rm -rf /tmp/mem0

# Mem0 currently defaults pgvector to 1536 dimensions.
# Our Bifrost Nemotron embedder returns 2048 dimensions.
RUN python - <<'PY'
from pathlib import Path

p = Path("/app/main.py")
s = p.read_text()

old = '''            "collection_name": POSTGRES_COLLECTION_NAME,
        },'''

new = '''            "collection_name": POSTGRES_COLLECTION_NAME,
            "embedding_model_dims": int(os.environ.get("MEM0_EMBEDDING_MODEL_DIMS", "1536")),
        },'''

if old not in s:
    raise SystemExit("Expected pgvector config block was not found")

p.write_text(s.replace(old, new, 1))
PY

RUN pip install --no-cache-dir -r requirements.txt

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

EXPOSE 8000

CMD ["sh", "-c", "alembic upgrade head && uvicorn main:app --host 0.0.0.0 --port 8000"]
EOF