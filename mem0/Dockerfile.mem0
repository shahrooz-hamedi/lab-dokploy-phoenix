RUN python - <<'PY'
from pathlib import Path

p = Path("/app/main.py")
s = p.read_text()

old = '''            "collection_name": POSTGRES_COLLECTION_NAME,
        },'''

new = '''            "collection_name": POSTGRES_COLLECTION_NAME,
            "embedding_model_dims": int(os.environ.get("MEM0_EMBEDDING_MODEL_DIMS", "1536")),
        },'''

if old not in s:
    raise SystemExit("Expected pgvector configuration block not found")

p.write_text(s.replace(old, new, 1))

p = Path("/app/mem0/vector_stores/pgvector.py")
s = p.read_text()

old = '''            connection_string = f"postgresql://{user}:{password}@{host}:{port}/{dbname}"'''

new = '''            from urllib.parse import quote
            connection_string = (
                f"postgresql://{quote(str(user), safe='')}:"
                f"{quote(str(password), safe='')}@"
                f"{host}:{port}/{dbname}"
            )'''

if old not in s:
    raise SystemExit("Expected PostgreSQL connection string construction not found")

s = s.replace(old, new, 1)

old = '''                self.connection_pool.open(wait=True)'''

new = '''                self.connection_pool.open(wait=False)'''

if old not in s:
    raise SystemExit("Expected wait=True patch not found")

s = s.replace(old, new, 1)

p.write_text(s)
PY