#!/bin/sh
set -eu

# --------------------------------------------------
# HUB SIP / RTP forwarding through HUB-LAB
# --------------------------------------------------

PBX="192.168.11.30"
PBX_CIDR="${PBX}/32"

WAN_IFACE="eth0"
TUN_IFACE="ct-hub-lab"

SIP_SERVER="185.98.113.196/32"
RTP_NETWORKS="
185.98.113.208/29
185.98.113.216/29
185.98.113.120/29
"

echo "[HUB-SIP] Waiting for interfaces..."

i=0
until ip link show dev "$WAN_IFACE" >/dev/null 2>&1 \
   && ip link show dev "$TUN_IFACE" >/dev/null 2>&1; do
    i=$((i + 1))
    if [ "$i" -ge 30 ]; then
        echo "[HUB-SIP] ERROR: Required interfaces unavailable." >&2
        exit 1
    fi
    sleep 1
done

# --------------------------------------------------
# Verify forwarding and the FreePBX route
# --------------------------------------------------

if [ "$(sysctl -n net.ipv4.ip_forward)" != "1" ]; then
    echo "[HUB-SIP] ERROR: IPv4 forwarding is disabled." >&2
    exit 1
fi

if ! ip route get "$PBX" | grep -Eq \
    "(^|[[:space:]])dev ${TUN_IFACE}([[:space:]]|$)"; then
    echo "[HUB-SIP] ERROR: FreePBX route does not use ${TUN_IFACE}." >&2
    ip route get "$PBX" >&2 || true
    exit 1
fi

# --------------------------------------------------
# Idempotent iptables rule installer
# --------------------------------------------------

ensure_rule() {
    TABLE="$1"
    CHAIN="$2"
    shift 2

    if ! iptables -w -t "$TABLE" -C "$CHAIN" "$@" 2>/dev/null; then
        iptables -w -t "$TABLE" -I "$CHAIN" 1 "$@"
    fi
}

echo "[HUB-SIP] Installing incoming SIP DNAT..."

# SIP UDP 5060
ensure_rule nat PREROUTING \
    -i "$WAN_IFACE" \
    -s "$SIP_SERVER" \
    -p udp --dport 5060 \
    -j DNAT --to-destination "${PBX}:5060"

# Permit incoming SIP forwarding
ensure_rule filter FORWARD \
    -i "$WAN_IFACE" -o "$TUN_IFACE" \
    -s "$SIP_SERVER" -d "$PBX_CIDR" \
    -p udp --dport 5060 \
    -m conntrack --ctstate NEW,ESTABLISHED,RELATED \
    -j ACCEPT

echo "[HUB-SIP] Installing incoming RTP DNAT..."

# RTP UDP 10000-10019
# The destination port is preserved.
for NET in $RTP_NETWORKS; do

    ensure_rule nat PREROUTING \
        -i "$WAN_IFACE" \
        -s "$NET" \
        -p udp --dport 10000:10019 \
        -j DNAT --to-destination "$PBX"

    ensure_rule filter FORWARD \
        -i "$WAN_IFACE" -o "$TUN_IFACE" \
        -s "$NET" -d "$PBX_CIDR" \
        -p udp --dport 10000:10019 \
        -m conntrack --ctstate NEW,ESTABLISHED,RELATED \
        -j ACCEPT

done

# --------------------------------------------------
# FreePBX -> provider forwarding and source NAT
# --------------------------------------------------

echo "[HUB-SIP] Installing outgoing provider forwarding..."

for NET in "$SIP_SERVER" $RTP_NETWORKS; do

    # Permit FreePBX-originated traffic to provider networks.
    ensure_rule filter FORWARD \
        -i "$TUN_IFACE" -o "$WAN_IFACE" \
        -s "$PBX_CIDR" -d "$NET" \
        -m conntrack --ctstate NEW,ESTABLISHED,RELATED \
        -j ACCEPT

    # Translate FreePBX source to the HUB container address.
    # Docker handles the subsequent bridge egress NAT.
    ensure_rule nat POSTROUTING \
        -o "$WAN_IFACE" \
        -s "$PBX_CIDR" -d "$NET" \
        -j MASQUERADE

done

# --------------------------------------------------
# Established return traffic
# --------------------------------------------------

ensure_rule filter FORWARD \
    -i "$WAN_IFACE" -o "$TUN_IFACE" \
    -d "$PBX_CIDR" \
    -m conntrack --ctstate ESTABLISHED,RELATED \
    -j ACCEPT

ensure_rule filter FORWARD \
    -i "$TUN_IFACE" -o "$WAN_IFACE" \
    -s "$PBX_CIDR" \
    -m conntrack --ctstate ESTABLISHED,RELATED \
    -j ACCEPT

# --------------------------------------------------
# Verification output
# --------------------------------------------------

echo
echo "[HUB-SIP] Forwarding configuration installed."

echo
echo "========== NAT PREROUTING =========="
iptables -t nat -vnL PREROUTING

echo
echo "========== NAT POSTROUTING =========="
iptables -t nat -vnL POSTROUTING

echo
echo "========== FORWARD =========="
iptables -vnL FORWARD
