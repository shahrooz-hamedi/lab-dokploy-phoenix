#!/bin/sh
set -eu

IFACE="ct-hub-lab"

echo "[HUB-LAB-ROUTES] Waiting for ${IFACE}..."

i=0
until ip link show dev "$IFACE" >/dev/null 2>&1; do
    i=$((i + 1))
    if [ "$i" -ge 30 ]; then
        echo "[HUB-LAB-ROUTES] ERROR: ${IFACE} is unavailable." >&2
        exit 1
    fi
    sleep 1
done

echo "[HUB-LAB-ROUTES] Installing LAB network routes..."

ip route replace 192.168.10.0/24 dev "$IFACE"
ip route replace 192.168.11.0/24 dev "$IFACE"

echo "[HUB-LAB-ROUTES] Installed routes:"
ip route show 192.168.10.0/24
ip route show 192.168.11.0/24